{
  "name": "Kit Count",
  "short_name": "Kit Count",
  "description": "Scan and count kit boxes, pallets, and containers",
  "id": "/v5/scan",
  "start_url": "/v5/scan",
  "scope": "/v5/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0f1115",
  "icons": [
    {
      "src": "/v5/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/v5/kit-count-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/v5/kit-count-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/v5/kit-count-icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/v5/kit-count-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
