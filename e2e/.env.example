# Copy to e2e/.env and fill in values. Never commit e2e/.env.

# App under test (Vite HTTPS by default)
BASE_URL=https://localhost:5173

# Supabase Auth — active admin user used by browser fixtures
E2E_EMAIL=you@example.com
E2E_PASSWORD=your-password

# Database used by fixtures AND injected into the browser via window.__CLOUD_CONFIG__
# Prefer a Supabase branch or local stack — not production.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional but recommended: service role for seed/cleanup after migration 062
# (anon can no longer read/write tables). Also accepted:
#   SYNC_SUPABASE_SERVICE_KEY / V2_SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SERVICE_KEY=your-service-role-key
