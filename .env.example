# Set these in Vercel → Project → Settings → Environment Variables
# (never commit real values)

# ---- Auth (edge session cookie) ------------------------------------
# HMAC secret for the ms_auth cookie issued after Supabase Auth login.
COOKIE_SECRET=generate-a-long-random-string-here

# ---- Supabase ------------------------------------------------------
# Project URL from Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://qqdvzcaukstfdixnfuqq.supabase.co
# Service-role JWT — server-only, NEVER expose to the browser
SUPABASE_SERVICE_KEY=eyJ...your-service-role-jwt...
# Optional: anon key (browser already embeds it; used by auth admin helpers)
# SUPABASE_ANON_KEY=

# ---- Postmark (optional — add later) -------------------------------
# Not required to run auth. Admins share setup links from Users panel.
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM_EMAIL=live@measured.events

# ---- Sync infrastructure -------------------------------------------
# Comma-separated legacy ids the sync function is allowed to touch.
# Defaults to "mo95nl29jb46o,mpbb01nnvy0t7,__recipes__,__bugs__".
# Set to "true" via SYNC_ALL to allow ALL stock_events rows.
# SYNC_SCOPE=mo95nl29jb46o,mpbb01nnvy0t7,__recipes__,__bugs__
# SYNC_ALL=true

# Bearer secret required on /api/sync-catchup. Vercel cron sends it
# automatically when set. Generate with `openssl rand -hex 32`.
# CRON_SECRET=
