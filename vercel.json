{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd v5 && npm install && npm run build && rm -f index.html admin.html && cp -R dist/. . && rm -rf dist",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "/v2.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/mobile.html"
    },
    {
      "source": "/legacy",
      "destination": "/index.html"
    },
    {
      "source": "/v5/admin",
      "destination": "/v5/admin.html"
    },
    {
      "source": "/v5/admin/:path*",
      "destination": "/v5/admin.html"
    },
    {
      "source": "/v5/scan",
      "destination": "/v5/scan.html"
    },
    {
      "source": "/v5/scan/",
      "destination": "/v5/scan.html"
    }
  ],
  "headers": [
    {
      "source": "/v2.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/v5/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/v5",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/v5/scan.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/v5/kit-count.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/js/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/v5/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/v5/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync-catchup",
      "schedule": "0 3 * * *"
    }
  ]
}
