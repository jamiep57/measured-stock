{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd v5 && npm install && npm run build && node ../scripts/copy-v5-dist.mjs",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/v5",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/v5/",
      "destination": "/app/",
      "permanent": true
    },
    {
      "source": "/v5/admin",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v5/admin.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v5/admin/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/v5/scan",
      "destination": "/scan",
      "permanent": true
    },
    {
      "source": "/v5/scan/",
      "destination": "/scan/",
      "permanent": true
    },
    {
      "source": "/v5/index.html",
      "destination": "/app",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/setup",
      "destination": "/setup.html"
    },
    {
      "source": "/onboard",
      "destination": "/onboard.html"
    },
    {
      "source": "/mobile",
      "destination": "/mobile.html"
    },
    {
      "source": "/legacy",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/",
      "destination": "/app.html"
    },
    {
      "source": "/scan",
      "destination": "/scan.html"
    },
    {
      "source": "/scan/",
      "destination": "/scan.html"
    },
    {
      "source": "/",
      "destination": "/admin.html"
    },
    {
      "source": "/library",
      "destination": "/admin.html"
    },
    {
      "source": "/kit-library",
      "destination": "/admin.html"
    },
    {
      "source": "/suppliers",
      "destination": "/admin.html"
    },
    {
      "source": "/warehouses",
      "destination": "/admin.html"
    },
    {
      "source": "/volume-pools",
      "destination": "/admin.html"
    },
    {
      "source": "/users",
      "destination": "/admin.html"
    },
    {
      "source": "/case-sizes",
      "destination": "/admin.html"
    },
    {
      "source": "/bugs",
      "destination": "/admin.html"
    },
    {
      "source": "/dev",
      "destination": "/admin.html"
    },
    {
      "source": "/dev/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/settings",
      "destination": "/admin.html"
    },
    {
      "source": "/settings/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/events",
      "destination": "/admin.html"
    },
    {
      "source": "/events/:path*",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/v2.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/scan.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/kit-count.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/js/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync-catchup",
      "schedule": "0 3 * * *"
    }
  ]
}
