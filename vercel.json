{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/v2.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/mobile.html"
    },
    {
      "source": "/legacy",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-catchup",
      "schedule": "0 3 * * *"
    }
  ]
}
